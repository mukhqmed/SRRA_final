digraph D {
  rankdir=LR; graph [fontname="DejaVu Sans", fontsize=10, nodesep=0.4, ranksep=0.6, pad=0.2, compound=true];
  node [fontname="DejaVu Sans", fontsize=9]; edge [fontname="DejaVu Sans", fontsize=8, color="#5f5e5a"];
  op [label="Оператор\nдиспетчерской", shape=box, style=filled, fillcolor="#e8f0fb", color="#2a78d6"];
  an [label="Аналитик / ERP", shape=box, style=filled, fillcolor="#e8f0fb", color="#2a78d6"];
  subgraph cluster_ctl { label="Граница доверия: OT-сеть диспетчерской"; style=dashed; color="#d03b3b"; fontcolor="#d03b3b"; fontsize=9;
    p1 [label="P1 Сервис\nаварийных команд", shape=ellipse, style=filled, fillcolor="#f3f2ee"];
    p2 [label="P2 Диспетчеризация\nрейсов (FMS)", shape=ellipse, style=filled, fillcolor="#f3f2ee"];
    p3 [label="P3 Сервис\nотчётности", shape=ellipse, style=filled, fillcolor="#f3f2ee"];
    ds1 [label="DS1 БД техники", shape=cylinder, style=filled, fillcolor="#f3f2ee"];
    ds2 [label="DS2 Журнал команд\n(аудит)", shape=cylinder, style=filled, fillcolor="#f3f2ee"];
  }
  subgraph cluster_field { label="Граница доверия: радиосеть и машины"; style=dashed; color="#d03b3b"; fontcolor="#d03b3b"; fontsize=9;
    tr [label="Бортовой контроллер\nсамосвала", shape=box, style=filled, fillcolor="#e8f0fb", color="#2a78d6"];
  }
  op -> p1 [label="F1 нажатие E-stop / возобновить"];
  op -> p2 [label="F2 задания"];
  p1 -> tr [label="F3 команда стоп (радио)"];
  p2 -> tr [label="F4 маршрут, зоны"];
  tr -> p2 [label="F5 телеметрия, heartbeat"];
  p1 -> ds2 [label="F6 запись"];
  p2 -> ds1 [label="F7"];
  p3 -> ds1 [label="F8 запросы"];
  an -> p3 [label="F9 отчёты (HTTPS)"];
}
